{
  "name": "homelab-dashboard",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/types": "./src/lib/types.d.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "demo": "DEMO=1 node build",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
