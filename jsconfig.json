{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false
  }
}
