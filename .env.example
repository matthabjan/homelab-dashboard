# Stack variables for the Portainer stack in the README.
# config/services.yaml references the secrets below as ${NAME}.
TZ=UTC

# --- Secrets ---------------------------------------------------------------
# Passed into the container as files in /run/secrets, not as environment variables.
# Every name must be present; leave the value empty for integrations you don't use.
PVE_TOKEN_SECRET=
PBS_TOKEN_SECRET=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OMV_PASSWORD=
ADGUARD_PASSWORD=
PORTAINER_KEY=

# --- Access ----------------------------------------------------------------
DASHBOARD_HOST=dashboard.example.com
# Who may open the dashboard is set by the admin-only@file middleware in Traefik's dynamic config.
# Login: output of `htpasswd -nbB admin 'your-password'`.
# In this file keep the single quotes. In Portainer's variable editor write every $ as $$ instead.
DASHBOARD_AUTH_USERS='admin:$2y$05$replace.this.with.your.own.bcrypt.hash'

TLS_DOMAIN=example.com



