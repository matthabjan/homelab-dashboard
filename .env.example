# Copy to .env (docker compose) or enter as stack variables (Portainer).
# config/services.yaml references the secrets below as ${NAME}.
TZ=Europe/Berlin

# --- Secrets ---------------------------------------------------------------
# Passed into the container as files in /run/secrets, not as environment variables.
# Every name must be present; leave the value empty for integrations you don't use.
PVE_TOKEN_SECRET=
PBS_TOKEN_SECRET=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OMV_PASSWORD=
ADGUARD_PASSWORD=
PORTAINER_KEY=

# --- Access ----------------------------------------------------------------
DASHBOARD_HOST=dashboard.example.com
# who may open the dashboard
LAN_CIDRS=192.168.1.0/24
# Login: output of `htpasswd -nbB admin 'your-password'`.
# In this file keep the single quotes. In Portainer's variable editor write every $ as $$ instead.
DASHBOARD_AUTH_USERS='admin:$2y$05$replace.this.with.your.own.bcrypt.hash'

# --- Traefik (values from your traefik.yml) --------------------------------
TLS_DOMAIN=example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_NETWORK=proxy

# Absolute path to your config folder (needed for Portainer stacks deployed from git)
# CONFIG_PATH=/opt/docker/dashboard/config

# Preview without real APIs: DEMO=1 (DEMO_SCENARIO=issues|calm)
DEMO=0
